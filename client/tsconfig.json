{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Vite resolves imports, not node — which is also what lets the existing
    // extensionless relative imports stay as they are.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts", "src/**/*.tsx", "vite.config.ts",
    // Type-only, as before — plus resolve.ts, whose functions the client now
    // imports outright rather than keeping a second copy of. Checked here
    // without node's types, so a node built-in creeping into it fails this
    // typecheck instead of the bundle.
    "../server/types.ts", "../server/resolve.ts"
  ]
}
