{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Vite resolves imports, not node — which is also what lets the existing
    // extensionless relative imports stay as they are.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts", "../server/types.ts"]
}
